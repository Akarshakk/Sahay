# Application
NODE_ENV=development
PORT=3000

# PostgreSQL Database (Primary - Users, Auth, Incidents)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=civicsync
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=civicsync

# MongoDB Database (Secondary - Community Pulse)
MONGODB_URI=mongodb://localhost:27017/civicsync_community

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Geospatial Settings
DEFAULT_SEARCH_RADIUS_METERS=2000
VERIFICATION_THRESHOLD=5
